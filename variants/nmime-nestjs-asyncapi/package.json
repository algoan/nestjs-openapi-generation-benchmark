{
  "name": "petstore-app",
  "version": "1.0.0",
  "private": true,
  "description": "Generic NestJS demo app reproducing the patterns of Algoan backend services",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test:e2e": "MONGOMS_SYSTEM_BINARY=${MONGOMS_SYSTEM_BINARY:-$(command -v mongod)} jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/microservices": "11.2.8",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "12.1.2",
    "@nmime/nestjs-asyncapi": "2.0.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "mongodb": "6.22.0",
    "mongoose": "8.24.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jest": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "simple-git": "4.0.2",
    "@simple-git/argv-parser": "2.0.1",
    "js-yaml@^4": "4.3.2",
    "zod": "4.6.7"
  }
