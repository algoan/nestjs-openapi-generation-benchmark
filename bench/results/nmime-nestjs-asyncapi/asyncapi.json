{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Petstore events",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "servers": {},
  "components": {
    "schemas": {
      "Adopter": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "maxLength": 80
          },
          "lastName": {
            "type": "string",
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "description": "Phone number, in the E.164 format"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email"
        ]
      },
      "AdoptionRequestedEvent": {
        "type": "object",
        "properties": {
          "adoptionId": {
            "type": "string"
          },
          "shelterId": {
            "type": "string"
          },
          "animalId": {
            "type": "string"
          },
          "species": {
            "enum": [
              "CAT",
              "DOG"
            ],
            "type": "string"
          },
          "adopter": {
            "$ref": "#/components/schemas/Adopter"
          },
          "fee": {
            "type": "number",
            "description": "Adoption fee, in euros"
          }
        },
        "required": [
          "adoptionId",
          "shelterId",
          "animalId",
          "species",
          "adopter",
          "fee"
        ]
      },
      "AdoptionDecidedEvent": {
        "type": "object",
        "properties": {
          "adoptionId": {
            "type": "string"
          },
          "shelterId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ],
            "type": "string"
          },
          "rejectionReason": {
            "type": "string",
            "description": "Why the request was rejected"
          },
          "decidedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "adoptionId",
          "shelterId",
          "status",
          "decidedAt"
        ]
      },
      "Author": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "birthYear": {
            "type": "number",
            "minimum": 1000,
            "maximum": 2100
          }
        },
        "required": [
          "name"
        ]
      },
      "Book": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "isbn": {
            "type": "string",
            "description": "ISBN-13, without dashes"
          },
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Author"
            }
          },
          "genre": {
            "enum": [
              "CARE_GUIDE",
              "TRAINING",
              "NOVEL",
              "CHILDREN"
            ],
            "type": "string"
          },
          "publishedOn": {
            "format": "date-time",
            "type": "string"
          },
          "pageCount": {
            "type": "number"
          },
          "language": {
            "type": "string",
            "description": "ISO 639-1 language code"
          },
          "topics": {
            "description": "Species the book is about",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CAT",
                "DOG"
              ]
            }
          },
          "rating": {
            "type": "number",
            "description": "Average reader rating, from 0 to 5"
          },
          "available": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Value added by mongoose"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Value added by mongoose"
          }
        },
        "required": [
          "_id",
          "isbn",
          "title",
          "authors",
          "genre",
          "language",
          "topics",
          "available",
          "createdAt",
          "updatedAt"
        ]
      },
      "AdoptionCompletedEvent": {
        "type": "object",
        "properties": {
          "adoptionId": {
            "type": "string"
          },
          "shelterId": {
            "type": "string"
          }
        },
        "required": [
          "adoptionId",
          "shelterId"
        ]
      },
      "Vaccination": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Vaccine name"
          },
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "name",
          "date"
        ]
      },
      "VaccinationRecordedEvent": {
        "type": "object",
        "properties": {
          "shelterId": {
            "type": "string"
          },
          "animalId": {
            "type": "string"
          },
          "vaccination": {
            "$ref": "#/components/schemas/Vaccination"
          }
        },
        "required": [
          "shelterId",
          "animalId",
          "vaccination"
        ]
      },
      "BookStockChangedEvent": {
        "type": "object",
        "properties": {
          "isbn": {
            "type": "string"
          },
          "stock": {
            "type": "number"
          }
        },
        "required": [
          "isbn"
        ]
      }
    }
  },
  "defaultContentType": "application/json",
  "channels": {
    "adoption_requested": {
      "address": "adoption_requested",
      "messages": {
        "AdoptionsService_create": {
          "payload": {
            "$ref": "#/components/schemas/AdoptionRequestedEvent"
          },
          "name": "AdoptionsService_create"
        }
      }
    },
    "adoption_decided": {
      "address": "adoption_decided",
      "messages": {
        "AdoptionsService_decide": {
          "payload": {
            "$ref": "#/components/schemas/AdoptionDecidedEvent"
          },
          "name": "AdoptionsService_decide"
        }
      }
    },
    "book_published": {
      "address": "book_published",
      "messages": {
        "BooksService_create": {
          "payload": {
            "$ref": "#/components/schemas/Book"
          },
          "name": "BooksService_create"
        }
      }
    },
    "adoption_completed": {
      "address": "adoption_completed",
      "messages": {
        "EventsController_onAdoptionCompleted": {
          "payload": {
            "$ref": "#/components/schemas/AdoptionCompletedEvent"
          },
          "name": "EventsController_onAdoptionCompleted"
        }
      }
    },
    "vaccination_recorded": {
      "address": "vaccination_recorded",
      "messages": {
        "EventsController_onVaccinationRecorded": {
          "payload": {
            "$ref": "#/components/schemas/VaccinationRecordedEvent"
          },
          "name": "EventsController_onVaccinationRecorded"
        }
      }
    },
    "book_restocked": {
      "address": "book_restocked",
      "messages": {
        "EventsController_onBookStockChanged": {
          "payload": {
            "$ref": "#/components/schemas/BookStockChangedEvent"
          },
          "name": "EventsController_onBookStockChanged"
        }
      }
    },
    "book_sold_out": {
      "address": "book_sold_out",
      "messages": {
        "EventsController_onBookStockChanged": {
          "payload": {
            "$ref": "#/components/schemas/BookStockChangedEvent"
          },
          "name": "EventsController_onBookStockChanged"
        }
      }
    }
  },
  "operations": {
    "adoption_requested_send": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/adoption_requested"
      },
      "messages": [
        {
          "$ref": "#/channels/adoption_requested/messages/AdoptionsService_create"
        }
      ]
    },
    "adoption_decided_send": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/adoption_decided"
      },
      "messages": [
        {
          "$ref": "#/channels/adoption_decided/messages/AdoptionsService_decide"
        }
      ]
    },
    "book_published_send": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/book_published"
      },
      "messages": [
        {
          "$ref": "#/channels/book_published/messages/BooksService_create"
        }
      ]
    },
    "adoption_completed_receive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/adoption_completed"
      },
      "summary": "Handle the adoption_completed event",
      "messages": [
        {
          "$ref": "#/channels/adoption_completed/messages/EventsController_onAdoptionCompleted"
        }
      ]
    },
    "vaccination_recorded_receive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/vaccination_recorded"
      },
      "summary": "Add a vaccination to the health record of an animal",
      "messages": [
        {
          "$ref": "#/channels/vaccination_recorded/messages/EventsController_onVaccinationRecorded"
        }
      ]
    },
    "book_restocked_receive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/book_restocked"
      },
      "summary": "Update the availability of a book when the bookshop's stock changes",
      "messages": [
        {
          "$ref": "#/channels/book_restocked/messages/EventsController_onBookStockChanged"
        }
      ]
    },
    "book_sold_out_receive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/book_sold_out"
      },
      "summary": "Update the availability of a book when the bookshop's stock changes",
      "messages": [
        {
          "$ref": "#/channels/book_sold_out/messages/EventsController_onBookStockChanged"
        }
      ]
    }
  }
}